# OpenRouter configuration. Default concurrency: 20.
OPENROUTER_API_KEY=
JEV_API_KEY=
JEV_BASE_URL=https://openrouter.ai/api/alpha/decisions
JEV_MODEL=typesafe/jev-1.13

# scripts/run_sag2.py --scorer reranker (default): every returned score is a RAW LOGIT.
# The adapter applies sigmoid exactly once. Do not point it at a probability API.
RERANK_API_KEY=
RERANK_BASE_URL=http://your-reranker-host:8000/v1
RERANK_ENDPOINT=/rerank
RERANK_MODEL=your-reranker-model
RERANK_BATCH_SIZE=32

# Agentic planning LLM; also the fallback for answer generation.
# BASE_URL includes /v1. API may be chat or responses; custom APIs usually use chat.
LLM_API_KEY=
LLM_BASE_URL=http://your-llm-host:8000/v1
LLM_MODEL=your-llm-model
LLM_API=chat
# default omits the vendor-specific reasoning_effort parameter.
LLM_REASONING_EFFORT=default
# New unified entry point: disable JSON mode if the provider rejects response_format.
LLM_JSON_MODE=true
LLM_STRICT_TOOLS=false
LLM_PARALLEL_TOOL_CALLS_PARAMETER=false

# Optional independent answer LLM. Empty values inherit the corresponding LLM_* value.
# Only used by scripts/run_sag2.py --task qa; retrieval-only needs no answer credentials.
ANSWER_API_KEY=
ANSWER_BASE_URL=
ANSWER_MODEL=
ANSWER_API=
